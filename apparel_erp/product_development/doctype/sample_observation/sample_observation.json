{
  "doctype": "DocType",
  "name": "Sample Observation",
  "module": "Product Development",
  "naming_rule": "Expression",
  "autoname": "format:SMO-{#####}",
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "sample_version",
      "fieldtype": "Link",
      "options": "Sample Version",
      "label": "Sample Version",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {"fieldname": "seq", "fieldtype": "Int", "label": "Seq", "read_only": 1, "description": "Display index only, re-sequenced on delete. Never used as identity."},
    {"fieldname": "category", "fieldtype": "Link", "options": "Observation Category", "label": "Category", "in_list_view": 1},
    {"fieldname": "observation_text", "fieldtype": "Small Text", "label": "Observation", "reqd": 1, "in_list_view": 1},
    {"fieldname": "is_free_text", "fieldtype": "Check", "label": "Free Text", "description": "Set when not chosen from the stage's observation set - feeds the promotion report so recurring free-text entries can be promoted into the master list."},
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Open\nResolved\nCarried Forward",
      "default": "Open",
      "label": "Status",
      "in_list_view": 1
    },
    {"fieldname": "carried_from", "fieldtype": "Link", "options": "Sample Observation", "label": "Carried From", "read_only": 1, "description": "Set by carry-forward when this observation is a copy of an earlier version's unresolved one."}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "All", "read": 1, "write": 1, "create": 1}
  ]
}
