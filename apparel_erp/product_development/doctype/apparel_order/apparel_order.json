{
 "doctype": "DocType",
 "name": "Apparel Order",
 "module": "Product Development",
 "autoname": "format:APO-{#####}",
 "engine": "InnoDB",
 "track_changes": 1,
 "fields": [
  {"fieldname": "style", "fieldtype": "Link", "label": "Style", "options": "Style", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "buyer_po", "fieldtype": "Data", "label": "Buyer PO", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "customer", "fieldtype": "Data", "label": "Customer / Buyer", "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nConfirmed\nIn Production\nShipped\nClosed\nCancelled", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "cb1", "fieldtype": "Column Break"},
  {"fieldname": "currency", "fieldtype": "Data", "label": "Currency", "default": "INR"},
  {"fieldname": "incoterm", "fieldtype": "Data", "label": "Incoterm", "default": "FOB"},
  {"fieldname": "delivery_date", "fieldtype": "Date", "label": "Delivery / Ex-factory Date"},
  {"fieldname": "sb_matrix", "fieldtype": "Section Break", "label": "Order Matrix"},
  {"fieldname": "order_matrix", "fieldtype": "Table", "options": "Apparel Order Matrix Item", "label": "Colour x Size Quantities", "description": "Only non-zero cells here are treated as actually ordered - the BOM Generator and production readiness checks read this, not the raw colour x size matrix, to decide what to build."},
  {"fieldname": "total_quantity", "fieldtype": "Int", "label": "Total Quantity", "read_only": 1, "in_list_view": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Manufacturing Manager", "read": 1, "write": 1, "create": 1}
 ]
}
